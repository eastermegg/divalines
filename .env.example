# Copy to .env.local and fill in. The app runs WITHOUT any of these:
# the waitlist API falls back to a logged dev mode (no insert).

NEXT_PUBLIC_SITE_URL=https://divalines.com

# Supabase — server only, never NEXT_PUBLIC (see docs/SETUP.md)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing visitor IPs (RGPD: raw IP is never stored)
IP_SALT=

# Launch date shown by the countdown (ISO 8601 with timezone)
RELEASE_DATE=2026-10-01T18:00:00+02:00

# Used by the Supabase Edge Function (set via `supabase secrets set`, not here):
# NOTION_TOKEN=ntn_...
# NOTION_DATABASE_ID=...
